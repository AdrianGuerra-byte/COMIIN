---
// Reseñas de Participantes COMIIN

interface Review {
  name: string;
  role: string;
  avatar: string;
  text: string;
  rating: number;
}

const reviews: Review[] = [
  {
    name: "Dra. Karla Salazar Serna",
    role: "Conferencista Magistral",
    avatar: "https://images.unsplash.com/photo-1494790108755-2616b612b786?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80",
    text: "Sin duda el diálogo genera conocimiento, y cuando existen oportunidades para establecer espacios académicos donde los aportes científicos se colocan al servicio de la sociedad y se materializan en esfuerzos colectivos e interinstitucionales se abren grandes posibilidades para fortalecer no sólo vínculos académicos, sino esfuerzos colectivos orientados a transformaciones efectivas sobre las problemáticas sociales que aquejan a la sociedad. El Congreso realizado representa todo lo anterior.",
    rating: 5
  },
  {
    name: "Dr. Francisco Rojo Muñoz",
    role: "Conferencista",
    avatar: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80",
    text: "El 1er Congreso de Investigación en Ciencias Sociales y Humanidades del CUH fue una experiencia académica valiosa. Destacó la calidad de las ponencias, el diálogo entre investigadores y el interés por abordar problemáticas sociales actuales. Fue un espacio que fortaleció la reflexión y motivó a continuar desarrollando investigación con impacto.",
    rating: 4.5
  },
  {
    name: "Dra. Laura Georgina Ortega Luna",
    role: "Coordinadora de Mesa y Ponente",
    avatar: "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80",
    text: "Muy buenos anfitriones, muy interesantes las actividades y las discusiones.",
    rating: 5
  }
];

function renderStars(rating: number) {
  const fullStars = Math.floor(rating);
  const hasHalfStar = rating % 1 !== 0;
  const emptyStars = 5 - Math.ceil(rating);

  return {
    full: fullStars,
    half: hasHalfStar ? 1 : 0,
    empty: emptyStars
  };
}
---

<section class="reviews-section">
  <div class="container">
    <header class="section-header">
      <h2>Reseñas de Participantes</h2>
      <p>Lo que dicen quienes han vivido la experiencia COMIIN</p>
    </header>

    <div class="reviews-grid">
      {reviews.map((review) => {
        const stars = renderStars(review.rating);
        return (
          <article class="review-card">
            <header class="review-header">
              <div class="review-avatar">
                <img
                  src={review.avatar}
                  alt={`Foto de ${review.name}`}
                  loading="lazy"
                />
              </div>
              <div class="review-info">
                <h3>{review.name}</h3>
                <p>{review.role}</p>
              </div>
            </header>

            <blockquote class="review-text">
              {review.text}
            </blockquote>

            <footer class="review-rating" aria-label={`Calificación: ${review.rating} de 5 estrellas`}>
              {[...Array(stars.full)].map(() => (
                <i class="fas fa-star" aria-hidden="true"></i>
              ))}
              {stars.half > 0 && <i class="fas fa-star-half-alt" aria-hidden="true"></i>}
              {[...Array(stars.empty)].map(() => (
                <i class="far fa-star" aria-hidden="true"></i>
              ))}
            </footer>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .reviews-section {
    padding: 5rem 2rem;
    background: linear-gradient(180deg, #e9ecef 0%, #dee2e6 100%);
  }

  .container {
    max-width: 1200px;
    margin-inline: auto;
  }

  /* Header de la sección */
  .section-header {
    text-align: center;
    margin-block-end: 3rem;
  }

  .section-header h2 {
    font-size: clamp(2rem, 5vw, 2.5rem);
    font-weight: 700;
    color: #1F407F;
    position: relative;
    display: inline-block;
    padding-block-end: 1rem;
  }

  .section-header h2::after {
    content: '';
    position: absolute;
    inset-block-end: 0;
    inset-inline-start: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 4px;
    background: #1F407F;
    border-radius: 2px;
  }

  .section-header p {
    font-size: 1.05rem;
    color: var(--text-light);
    margin-block-start: 1rem;
  }

  /* Grid de reseñas */
  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 350px), 1fr));
    gap: 2rem;
    align-items: stretch;
  }

  /* Tarjeta de reseña */
  .review-card {
    background: var(--white);
    border-radius: 16px;
    padding: 1.75rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid rgba(31, 64, 127, 0.08);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    height: 100%;
  }

  .review-card::before {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    inset-inline-end: 0;
    height: 5px;
    background: linear-gradient(90deg, #1F407F 0%, #2291C6 100%);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .review-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 16px 48px rgba(31, 64, 127, 0.15);
    border-color: rgba(31, 64, 127, 0.15);
  }

  .review-card:hover::before {
    transform: scaleX(1);
  }

  /* Header de la reseña */
  .review-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-block-end: 1rem;
    border-bottom: 1px solid rgba(31, 64, 127, 0.08);
  }

  .review-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid #1F407F;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(31, 64, 127, 0.2);
    transition: transform 0.3s ease;
  }

  .review-card:hover .review-avatar {
    transform: scale(1.05);
  }

  .review-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .review-info {
    flex: 1;
    min-width: 0;
  }

  .review-info h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: #1F407F;
    margin-block-end: 0.35rem;
    line-height: 1.3;
  }

  .review-info p {
    font-size: 0.9rem;
    color: var(--text-light);
    line-height: 1.4;
    font-weight: 500;
  }

  /* Texto de la reseña */
  .review-text {
    font-size: 0.975rem;
    line-height: 1.75;
    color: var(--text-color);
    font-style: italic;
    text-wrap: pretty;
    margin: 0;
    padding: 1.25rem 1rem;
    background: rgba(31, 64, 127, 0.02);
    border-radius: 8px;
    border-inline-start: 3px solid #1F407F;
    flex: 1;
    position: relative;
  }

  .review-text::before {
    content: '"';
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    color: #1F407F;
    font-size: 2.5rem;
    font-family: Georgia, serif;
    line-height: 1;
    opacity: 0.15;
  }

  /* Rating de estrellas */
  .review-rating {
    display: flex;
    gap: 0.3rem;
    font-size: 1.15rem;
    color: #ffc107;
    padding-block-start: 0.5rem;
    margin-block-start: auto;
  }

  .review-rating i {
    transition: transform 0.3s ease;
    filter: drop-shadow(0 2px 4px rgba(255, 193, 7, 0.3));
  }

  .review-card:hover .review-rating i {
    transform: scale(1.15) rotate(5deg);
  }

  .review-card:hover .review-rating i:nth-child(even) {
    transform: scale(1.15) rotate(-5deg);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .reviews-grid {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
      gap: 1.75rem;
    }
  }

  @media (max-width: 768px) {
    .reviews-section {
      padding: 4rem 1.5rem;
    }

    .section-header {
      margin-block-end: 2.5rem;
    }

    .reviews-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      max-width: 600px;
      margin: 0 auto;
    }

    .review-card {
      padding: 1.5rem;
      gap: 1.25rem;
    }

    .review-header {
      gap: 1rem;
      padding-block-end: 0.85rem;
    }

    .review-avatar {
      width: 56px;
      height: 56px;
    }

    .review-text {
      padding: 1rem 0.85rem;
      font-size: 0.95rem;
      line-height: 1.7;
    }

    .review-text::before {
      font-size: 2rem;
      top: 0.25rem;
      left: 0.25rem;
    }

    .review-rating {
      font-size: 1.05rem;
      gap: 0.25rem;
    }
  }

  @media (max-width: 480px) {
    .reviews-section {
      padding: 3rem 1rem;
    }

    .section-header h2::after {
      width: 60px;
      height: 3px;
    }

    .review-card {
      padding: 1.25rem;
      gap: 1rem;
      border-radius: 12px;
    }

    .review-header {
      padding-block-end: 0.75rem;
    }

    .review-avatar {
      width: 50px;
      height: 50px;
      border-width: 2px;
    }

    .review-info h3 {
      font-size: 1.05rem;
    }

    .review-info p {
      font-size: 0.85rem;
    }

    .review-text {
      padding: 0.85rem 0.75rem;
      font-size: 0.9rem;
      line-height: 1.65;
    }

    .review-text::before {
      font-size: 1.75rem;
      top: 0.15rem;
      left: 0.15rem;
    }

    .review-rating {
      font-size: 1rem;
      padding-block-start: 0.35rem;
    }
  }

  /* Accesibilidad y animaciones */
  @media (prefers-reduced-motion: reduce) {
    .review-card,
    .review-avatar,
    .review-rating i {
      transition: none;
      animation: none;
    }

    .review-card:hover {
      transform: none;
    }

    .review-card:hover .review-rating i {
      transform: none;
    }
  }
</style>