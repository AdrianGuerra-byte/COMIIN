---
// Hero con carrusel de fondo
interface Props {
  title?: string;
  subtitle?: string;
  ctaText?: string;
  ctaLink?: string;
  images?: string[];
  imageAlts?: string[];
}

const {
  title = "Segundo Congreso CUH - COMIIN 2026",
  subtitle = "",
  ctaText = "Más información",
  ctaLink = "#informacion",
  images = [
    "/hero/2-_MG_0853.avif",
    "/hero/3-_MG_0819.avif",
    "/hero/3-_MG_0895.avif",
    "/hero/4-_MG_0906.avif",
    "/hero/5-_MG_0943.avif",
    "/hero/6-IMG_0974.avif",
    "/hero/7-IMG_4530.avif",
    "/hero/IMG_1033 (1) (1).avif",
    "/hero/1-IMG_4548.avif",
    "/hero/2-_MG_0836.avif"

  ],
  imageAlts = [
    "Participantes del CINCISOH 2024",
    "Conferencia magistral CINCISOH 2024",
    "Exposición de proyectos académicos",
    "Presentación de investigaciones",
    "Sesiones académicas del congreso",
    "Ponentes y asistentes del evento",
    "Actividades del congreso",
    "Momentos destacados del CINCISOH"
  ]
} = Astro.props;
---

<section class="hero">
  <div class="hero-carousel">
    {images.map((image, index) => (
      <div
        class:list={["hero-slide", { active: index === 0 }]}
      >
        <img
          src={image}
          alt={imageAlts[index] || 'Fondo decorativo del congreso'}
          loading={index === 0 ? 'eager' : 'lazy'}
        />
      </div>
    ))}
  </div>

  <div class="hero-content">
    <div class="title-wrapper">
      <span class="title-line">Segundo Congreso CUH</span>
      <span class="title-main">COMIIN 2026</span>
    </div>
    <p>{subtitle}</p>
  </div>
</section>

<script>
  function initHeroCarousel() {
    const hero = document.querySelector('.hero');
    const slides = hero?.querySelectorAll('.hero-slide');

    if (!slides || slides.length <= 1) return; // No hay carrusel

    let currentSlide = 0;
    let carouselInterval: number | undefined;

    // Respetar preferencias de accesibilidad
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

    function changeSlide() {
      if (!slides) return;
      slides[currentSlide].classList.remove('active');
      currentSlide = (currentSlide + 1) % slides.length;
      slides[currentSlide].classList.add('active');
    }

    function startCarousel() {
      // No iniciar si el usuario no quiere movimiento
      if (motionQuery.matches) return;

      stopCarousel(); // Limpiar por si acaso
      carouselInterval = setInterval(changeSlide, 5000) as unknown as number;
    }

    function stopCarousel() {
      if (carouselInterval !== undefined) {
        clearInterval(carouselInterval);
        carouselInterval = undefined;
      }
    }

    // Iniciar el carrusel
    startCarousel();

    // Escuchar cambios en preferencias de movimiento
    motionQuery.addEventListener('change', () => {
      if (motionQuery.matches) {
        stopCarousel();
      } else {
        startCarousel();
      }
    });

    // Limpiar cuando se navegue a otra página (View Transitions)
    document.addEventListener('astro:before-preparation', stopCarousel, { once: true });
  }

  // Inicializar en carga inicial
  initHeroCarousel();

  // Re-inicializar después de navegación con View Transitions
  document.addEventListener('astro:page-load', initHeroCarousel);
</script>

<style>
  .hero {
    position: relative;
    height: 100vh;
    margin-top: 0;
    z-index: 1;
    min-height: 500px;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    color: var(--white);
    background-color: #1a1a1a;
  }

  .hero-carousel {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease-in-out;
    background-color: #1a1a1a; /* Fondo mientras carga la img */
  }

  .hero-slide.active {
    opacity: 1;
    z-index: 2;
  }

  /* MEJORA: Estilos para el <img> en lugar de background-image */
  .hero-slide img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover; /* Reemplaza a background-size: cover */
    object-position: center;

    /* Efecto "Ken Burns" sutil */
    transform: scale(1.1); /* Inicia con zoom */
    transition: transform 3s ease-out; /* Transición larga para el zoom */
  }

  /* MEJORA: Activa el zoom-out solo en el slide activo */
  .hero-slide.active img {
    transform: scale(1); /* Termina sin zoom */
  }

  /* Overlay para contraste (igual que antes) */
  .hero-slide::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0.25));
    z-index: 3; /* Encima de la imagen */
  }

  .hero-content {
    position: relative;
    z-index: 4; /* Encima de todo */
    max-width: 1000px;
    padding: 0 2rem;
    animation: fadeInUp 1s ease-out;
  }

  .title-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .title-line {
    font-size: clamp(1.5rem, 3.5vw, 2.2rem);
    font-weight: 300;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
    text-shadow:
      0 0 20px rgba(255, 255, 255, 0.5),
      2px 2px 8px rgba(0, 0, 0, 0.8);
    position: relative;
    -webkit-text-stroke: 0.5px rgba(255, 255, 255, 0.3);
  }

  .title-line::before {
    content: '';
    position: absolute;
    left: -60px;
    top: 50%;
    transform: translateY(-50%);
    width: 50px;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4));
  }

  .title-line::after {
    content: '';
    position: absolute;
    right: -60px;
    top: 50%;
    transform: translateY(-50%);
    width: 50px;
    height: 2px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.4), transparent);
  }

  .title-main {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 900;
    letter-spacing: 0.02em;
    color: rgba(230, 245, 255, 0.75);
    position: relative;
    text-transform: uppercase;
    line-height: 1;
    text-shadow:
      0 0 25px rgba(34, 145, 198, 0.4),
      0 0 40px rgba(255, 255, 255, 0.3),
      0 4px 12px rgba(0, 0, 0, 0.8),
      0 2px 4px rgba(0, 0, 0, 0.6);
    -webkit-text-stroke: 1px rgba(34, 145, 198, 0.35);
  }



  .hero h1 {
    font-size: clamp(2rem, 6vw, 3.5rem);
    margin-bottom: 1.5rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, #ffffff 0%, #e3f2fd 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.8));
    position: relative;
    padding: 0.5rem 0;
  }

  .hero h1::before {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #ffffff 0%, #e3f2fd 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: blur(20px);
    opacity: 0.4;
    z-index: -1;
  }

  .hero p {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    margin-bottom: 2rem;
    font-weight: 400;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.95);
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
  }

  .cta-button {
    background-color: var(--white);
    color: var(--primary-color);
    border: none;
    padding: 12px 30px;
    font-size: 1.1rem;
    font-weight: 500;
    border-radius: 50px;
    cursor: pointer;
    transition: var(--transition);
    box-shadow: var(--box-shadow);
    position: relative;
    overflow: hidden;
    text-decoration: none;
    display: inline-block;
  }

  .cta-button:hover {
    background-color: rgba(255, 255, 255, 0.9);
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
  }

  .cta-button:focus {
    outline: 3px solid var(--accent-color);
    outline-offset: 2px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero {
      height: 100vh;
      min-height: 400px;
    }

    .title-line {
      font-size: clamp(1.1rem, 3vw, 1.5rem);
      letter-spacing: 0.1em;
    }

    .title-line::before,
    .title-line::after {
      width: 30px;
      left: -40px;
      right: -40px;
    }

    .title-main {
      font-size: clamp(2.5rem, 7vw, 4rem);
    }

    .hero h1 {
      font-size: clamp(1.75rem, 5vw, 2.5rem);
      line-height: 1.25;
      margin-bottom: 1.25rem;
    }

    .hero p {
      font-size: clamp(0.95rem, 2vw, 1.1rem);
    }
  }

  /* MEJORA: Detener animación si el usuario lo prefiere */
  @media (prefers-reduced-motion: reduce) {
    .hero-slide img,
    .hero-slide.active img {
      animation: none;
      transform: scale(1); /* Sin zoom */
    }

    .hero-content {
      animation: none;
    }

    .title-main,
    .title-line {
      animation: none !important;
    }
  }

  @media (max-width: 480px) {
    .hero {
      height: 100vh;
      min-height: 350px;
    }

    .title-wrapper {
      gap: 0.35rem;
      margin-bottom: 1.5rem;
    }

    .title-line {
      font-size: clamp(0.95rem, 2.5vw, 1.2rem);
      letter-spacing: 0.08em;
    }

    .title-line::before,
    .title-line::after {
      display: none;
    }

    .title-main {
      font-size: clamp(2rem, 6vw, 3rem);
    }

    .hero h1 {
      font-size: clamp(1.5rem, 4.5vw, 2rem);
      margin-bottom: 1rem;
    }

    .hero p {
      font-size: clamp(0.9rem, 2vw, 1rem);
    }

    .hero-content {
      padding: 0 1rem;
    }
  }
</style>
